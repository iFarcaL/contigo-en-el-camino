{
  "mimeTypes": {
    ".xml": "application/xml",
    ".webmanifest": "application/manifest+json",
    ".svg": "image/svg+xml",
    ".ico": "image/x-icon",
    ".json": "application/json"
  },
  "routes": [
    {
      "route": "/sitemap.xml",
      "headers": {
        "Content-Type": "application/xml; charset=utf-8"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "Content-Type": "text/plain; charset=utf-8"
      }
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/sitemap.xml",
      "/robots.txt",
      "/uploads/*",
      "/og/*",
      "/*.{png,jpg,jpeg,gif,svg,ico,webp,css,js,json,txt,xml,webmanifest}"
    ]
  }
}
